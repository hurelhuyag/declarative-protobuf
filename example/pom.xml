<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.hurelhuyag</groupId>
        <artifactId>declarative-protobuf</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>declarative-protobuf-example</artifactId>
    <name>declarative-protobuf-example</name>
    <description>
        How to use declarative-protobuf from a consumer project: .proto files in, records and codecs out, and the
        Maven wiring that runs protoc and the generator before javac.
    </description>

    <!-- not published (see the central profile in the parent), so no sources or javadoc jar -->
    <properties>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <dependencies>
        <!-- the only runtime dependency: the facade and the wire helpers the generated codecs call -->
        <dependency>
            <groupId>io.github.hurelhuyag</groupId>
            <artifactId>declarative-protobuf-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. .proto files into a descriptor set; no protoc Java classes are generated -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>5.1.8</version>
                <configuration>
                    <protoc>${protobuf.version}</protoc>
                    <javaEnabled>false</javaEnabled>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/resources/proto</sourceDirectory>
                    </sourceDirectories>
                    <outputDescriptorFile>${project.build.directory}/generated/descriptors.pb</outputDescriptorFile>
                    <outputDescriptorIncludeImports>true</outputDescriptorIncludeImports>
                    <embedSourcesInClassOutputs>false</embedSourcesInClassOutputs>
                    <!-- declarative/options.proto travels in the api jar -->
                    <importDependencies>
                        <importDependency>
                            <groupId>io.github.hurelhuyag</groupId>
                            <artifactId>declarative-protobuf-api</artifactId>
                            <version>${project.version}</version>
                        </importDependency>
                    </importDependencies>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. the descriptor set into records and codecs -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <dependencies>
                    <dependency>
                        <groupId>io.github.hurelhuyag</groupId>
                        <artifactId>declarative-protobuf-generator</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-records</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.github.hurelhuyag.protobuf.generator.Main</mainClass>
                            <includePluginDependencies>true</includePluginDependencies>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <arguments>
                                <!-- optional customizations: <message pattern>=<java type>, each repeatable -->
                                <argument>--implements=example.orders.Order=io.github.hurelhuyag.protobuf.example.Identified</argument>
                                <argument>--annotate=*=io.github.hurelhuyag.protobuf.example.WireRecord</argument>
                                <argument>${project.build.directory}/generated/descriptors.pb</argument>
                                <argument>${project.build.directory}/generated-sources/records</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. the generated sources are ordinary sources -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-records</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/records</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
